    -- ── Helpers ────────────────────────────────────────────────────────
    function updateScrollBar()
        ContentList.Size = UDim2.new(1, 0, 0, ContentUIListLayout.AbsoluteContentSize.Y)
        local contentSize = ContentUIListLayout.AbsoluteContentSize.Y
        local viewportSize = ContentScrollFrame.AbsoluteSize.Y

        maxScroll = math.max(0, contentSize - viewportSize)

        if maxScroll <= 0 then
            ScrollThumb.Size = UDim2.new(1, -4, 1, 0)
            ScrollThumb.Position = UDim2.new(0, 2, 0, 0)
        else
            local visibleRatio = viewportSize / contentSize
            local thumbHeight = ScrollBarBg.AbsoluteSize.Y * visibleRatio
            ScrollThumb.Size = UDim2.new(1, -4, 0, math.max(thumbHeight, 30))
            local scrollRatio = scrollPosition / maxScroll
            local maxThumbPos = ScrollBarBg.AbsoluteSize.Y - ScrollThumb.AbsoluteSize.Y
            local thumbPos = scrollRatio * maxThumbPos
            ScrollThumb.Position = UDim2.new(0, 2, 0, thumbPos)
        end
    end

    function updateSliderPosition()
        if maxTabScroll <= 0 then
            TopSliderThumb.Size = UDim2.new(1, 0, 1, 0)
            TopSliderThumb.Position = UDim2.new(0, 0, 0, 0)
        else
            local visibleRatio = TabContainer.AbsoluteSize.X / TabList.AbsoluteSize.X
            local sliderWidth = TopSliderBg.AbsoluteSize.X * visibleRatio
            TopSliderThumb.Size = UDim2.new(0, math.max(sliderWidth, 40), 1, 0)
            local scrollRatio = (-tabScrollOffset) / maxTabScroll
            local maxSliderPos = TopSliderBg.AbsoluteSize.X - TopSliderThumb.AbsoluteSize.X
            TopSliderThumb.Position = UDim2.new(0, scrollRatio * maxSliderPos, 0, 0)
        end
    end

