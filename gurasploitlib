    local function tweenTabPosition(tab, targetX, duration)
        local startTime = tick()
        local startPos = tab.Position.X.Offset
        if tabAnimations[tab] then tabAnimations[tab]:Disconnect() end
        local conn
        conn = RunService.RenderStepped:Connect(function()
            local elapsed = tick() - startTime
            local progress = math.min(elapsed / duration, 1)
            local easeProgress = 1 - (1 - progress) ^ 3
            tab.Position = UDim2.new(0, startPos + (targetX - startPos) * easeProgress, 0, 0)
            if progress >= 1 then
                conn:Disconnect()
                tab.Position = UDim2.new(0, targetX, 0, 0)
                tabAnimations[tab] = nil
            end
        end)
        tabAnimations[tab] = conn
    end

    local function ensureNoOverlap()
        table.sort(tabs, function(a, b)
            return a.Position.X.Offset < b.Position.X.Offset
        end)
        for idx, tab in ipairs(tabs) do
            local correctX = (idx - 1) * (tabWidth + 5)
            tab.Position = UDim2.new(0, correctX, 0, 0)
        end
    end

