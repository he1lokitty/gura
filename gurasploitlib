local SCRIPT_ID = "DeepAgentUI_Session"

if _G[SCRIPT_ID] then
    pcall(function()
        if _G[SCRIPT_ID].Gui then _G[SCRIPT_ID].Gui:Destroy() end
        if _G[SCRIPT_ID].Connections then
            for _, c in ipairs(_G[SCRIPT_ID].Connections) do
                pcall(function() c:Disconnect() end)
            end
        end
    end)
    _G[SCRIPT_ID] = nil
end

for _, gui in ipairs(CoreGui:GetChildren()) do
    if gui.Name == "GuraSploit" or gui.Name == "DeepAgentUI" then
        gui:Destroy()
    end
end

local Connections = {}
local function track(conn)
    table.insert(Connections, conn)
    return conn
end

