        swatchLayout.VerticalAlignment = Enum.VerticalAlignment.Center
        swatchLayout.Padding = UDim.new(0, 5)

        local padding = Instance.new("UIPadding")
        padding.PaddingLeft = UDim.new(0, 8)
        padding.Parent = card

        local colors = {
            Color3.fromRGB(255, 0, 80),
            Color3.fromRGB(255, 120, 0),
            Color3.fromRGB(255, 220, 0),
            Color3.fromRGB(0, 220, 80),
            Color3.fromRGB(0, 180, 255),
            Color3.fromRGB(140, 0, 255),
            Color3.fromRGB(255, 255, 255),
            Color3.fromRGB(180, 180, 180),
        }

        local selectedSwatch = nil
        for _, col in ipairs(colors) do
            local swatch = Instance.new("TextButton")
            swatch.Parent = card
            swatch.Size = UDim2.new(0, 22, 0, 22)
            swatch.BackgroundColor3 = col
            swatch.Text = ""
            swatch.ZIndex = 3
            Instance.new("UICorner", swatch).CornerRadius = UDim.new(1, 0)

            local stroke = Instance.new("UIStroke")
            stroke.Color = Color3.new(1, 1, 1)
            stroke.Thickness = 0
            stroke.Parent = swatch

            swatch.MouseButton1Click:Connect(function()
                if selectedSwatch then
                    selectedSwatch:FindFirstChildWhichIsA("UIStroke").Thickness = 0
                end
                selectedSwatch = swatch
                stroke.Thickness = 2
                if onChanged then onChanged(col) end
            end)
        end
        return card
    end

    -- ── Window API ─────────────────────────────────────────────────────
    function Window:CreateTab(name)
        local Tab = {}
        local builder = nil

        local tabBtn = Instance.new("TextButton")
        tabBtn.Parent = TabList
        tabBtn.Size = UDim2.new(0, tabWidth, 1, 0)
        tabBtn.Position = UDim2.new(0, (#tabs) * (tabWidth + 5), 0, 0)
        tabBtn.BackgroundColor3 = GUI_COLORS.Section
        tabBtn.BackgroundTransparency = 0.5
        tabBtn.Text = name
        tabBtn.TextColor3 = Color3.fromRGB(200, 200, 200)
        tabBtn.Font = Enum.Font.Gotham
        tabBtn.TextSize = 12
        tabBtn.ZIndex = 3
        tabBtn.Name = "Tab" .. (#tabs + 1)

        local tabCorner = Instance.new("UICorner")
        tabCorner.CornerRadius = UDim.new(0, 6)
        tabCorner.Parent = tabBtn

        table.insert(tabs, tabBtn)
        table.insert(tabNames, name)
        tabButtonsByName[name] = tabBtn

        contentBuilders[name] = function(parent)
            if builder then builder(parent) end
        end

        tabBtn.MouseButton1Click:Connect(function()
            playTabClickSound()
            currentTabName = name
            showContentFor(name)
        end)

        -- Drag reorder
        tabBtn.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 then
                draggingTab = tabBtn
                draggingTabStart = input.Position.X
                draggedTabOffset = 0
                lastSwapTab = nil
                tabBtn.ZIndex = 10
                if tabAnimations[tabBtn] then
                    tabAnimations[tabBtn]:Disconnect()
                    tabAnimations[tabBtn] = nil
                end
            end
        end)
        tabBtn.InputEnded:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 and draggingTab == tabBtn then
                draggingTab = nil
                tabBtn.ZIndex = 3
                ensureNoOverlap()
            end
        end)

        TabList.Size = UDim2.new(0, (#tabs) * (tabWidth + 5), 1, 0)
        maxTabScroll = math.max(0, TabList.AbsoluteSize.X - TabContainer.AbsoluteSize.X)
        updateSliderPosition()

        if #tabs == 1 then
            currentTabName = name
            task.defer(function() showContentFor(name) end)
        end

        -- ── Tab components ─────────────────────────────────────────────
        function Tab:CreateSection(text)
            return createSectionLabel(ContentList, text)
        end

        function Tab:CreateButton(text, callback)
            return createButton(ContentList, text, callback)
        end

        function Tab:CreateToggle(text, default, callback)
            return createToggleRow(ContentList, text, default, callback)
        end

        function Tab:CreateSlider(text, min, max, default, callback)
            return createSlider(ContentList, text, min, max, default, callback)
        end

        function Tab:CreateKeybind(text, currentKey, callback)
            return createKeybindRow(ContentList, text, currentKey, callback)
        end

        function Tab:CreateTextbox(text, placeholder, callback)
            return createTextboxRow(ContentList, text, placeholder, callback)
        end

        function Tab:CreateColorPalette(text, callback)
            return createColorPaletteRow(ContentList, text, callback)
        end

        function Tab:CreateLabel(text)
            local lbl = Instance.new("TextLabel")
            lbl.Parent = ContentList
            lbl.Size = UDim2.new(1, 0, 0, 24)
            lbl.BackgroundTransparency = 1
            lbl.Text = text
            lbl.TextColor3 = GUI_COLORS.TextDim
            lbl.Font = Enum.Font.Gotham
            lbl.TextSize = 12
            lbl.TextXAlignment = Enum.TextXAlignment.Left
            lbl.ZIndex = 2
            return lbl
        end

        function Tab:CreateDivider()
            local div = Instance.new("Frame")
            div.Parent = ContentList
            div.Size = UDim2.new(1, 0, 0, 1)
            div.BackgroundColor3 = Color3.fromRGB(55, 55, 65)
            div.BorderSizePixel = 0
            div.ZIndex = 2
            return div
        end

        function Tab:SetBuilder(fn)
            builder = fn
        end

        return Tab
    end

    -- ── Scrollbar dragging ─────────────────────────────────────────────
    ScrollThumb.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            scrollThumbDragging = true
            scrollThumbDragStart = input.Position.Y
        end
    end)
    ScrollThumb.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            scrollThumbDragging = false
        end
    end)

    TopSliderThumb.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            topSliderDragging = true
            topSliderDragStart = input.Position.X
        end
    end)
    TopSliderThumb.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            topSliderDragging = false
        end
    end)

    track(UserInputService.InputChanged:Connect(function(input)
        if scrollThumbDragging and input.UserInputType == Enum.UserInputType.MouseMovement then
            local delta = input.Position.Y - scrollThumbDragStart
            local thumbMaxPos = ScrollBarBg.AbsoluteSize.Y - ScrollThumb.AbsoluteSize.Y
            if thumbMaxPos > 0 then
                local scrollMovement = (delta / thumbMaxPos) * maxScroll
                scrollPosition = math.clamp(scrollPosition + scrollMovement, 0, maxScroll)
                ContentList.Position = UDim2.new(0, 0, 0, -scrollPosition)
                updateScrollBar()
            end
            scrollThumbDragStart = input.Position.Y
        end

        if topSliderDragging and input.UserInputType == Enum.UserInputType.MouseMovement then
            local delta = input.Position.X - topSliderDragStart
            local maxSliderPos = TopSliderBg.AbsoluteSize.X - TopSliderThumb.AbsoluteSize.X
            if maxSliderPos > 0 then
                local scrollMovement = (delta / maxSliderPos) * maxTabScroll
                tabScrollOffset = math.clamp(tabScrollOffset - scrollMovement, -maxTabScroll, 0)
                TabList.Position = UDim2.new(0, tabScrollOffset, 0, 0)
                updateSliderPosition()
            end
            topSliderDragStart = input.Position.X
        end

        if tabScrollDragging and input.UserInputType == Enum.UserInputType.MouseMovement then
            local delta = input.Position.X - tabScrollStart
            tabScrollOffset = math.clamp(tabScrollOffset + delta, -maxTabScroll, 0)
            TabList.Position = UDim2.new(0, tabScrollOffset, 0, 0)
            updateSliderPosition()
            tabScrollStart = input.Position.X
        end

        if draggingTab and input.UserInputType == Enum.UserInputType.MouseMovement then
            local delta = input.Position.X - draggingTabStart
            draggedTabOffset = draggedTabOffset + delta
            draggingTab.Position = UDim2.new(0, draggingTab.Position.X.Offset + delta, 0, 0)
            draggingTabStart = input.Position.X

            for _, otherTab in ipairs(tabs) do
                if otherTab ~= draggingTab then
                    local dragPos = draggingTab.AbsolutePosition.X + (tabWidth / 2)
                    local otherPos = otherTab.AbsolutePosition.X + (tabWidth / 2)
                    if math.abs(dragPos - otherPos) < tabWidth / 2 and lastSwapTab ~= otherTab then
                        lastSwapTab = otherTab
                        local dragIndex = table.find(tabs, draggingTab)
                        local otherIndex = table.find(tabs, otherTab)
                        tabs[dragIndex], tabs[otherIndex] = tabs[otherIndex], tabs[dragIndex]
                        local targetX = (dragIndex - 1) * (tabWidth + 5)
                        tweenTabPosition(otherTab, targetX, 0.15)
                    end
                end
            end
        end
    end))

    TabScrollFrame.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            tabScrollDragging = true
            tabScrollStart = input.Position.X
        end
    end)
    TabScrollFrame.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            tabScrollDragging = false
        end
    end)

    local mouseOverTabs, mouseOverContent = false, false
    TabContainer.MouseEnter:Connect(function() mouseOverTabs = true end)
    TabContainer.MouseLeave:Connect(function() mouseOverTabs = false end)
    ContentScrollFrame.MouseEnter:Connect(function() mouseOverContent = true end)
    ContentScrollFrame.MouseLeave:Connect(function() mouseOverContent = false end)
    ScrollBarBg.MouseEnter:Connect(function() mouseOverContent = true end)
    ScrollBarBg.MouseLeave:Connect(function() mouseOverContent = false end)

    track(UserInputService.InputBegan:Connect(function(input, gp)
        if gp then return end
        if input.UserInputType ~= Enum.UserInputType.MouseWheel then return end

        if mouseOverTabs then
            local scrollAmount = 50
            tabScrollOffset = math.clamp(tabScrollOffset + (input.Position.Z > 0 and scrollAmount or -scrollAmount), -maxTabScroll, 0)
            TabList.Position = UDim2.new(0, tabScrollOffset, 0, 0)
            updateSliderPosition()
        elseif mouseOverContent then
            local scrollAmount = 30
            scrollPosition = math.clamp(scrollPosition + (input.Position.Z > 0 and -scrollAmount or scrollAmount), 0, maxScroll)
            ContentList.Position = UDim2.new(0, 0, 0, -scrollPosition)
            updateScrollBar()
        end
    end))

    -- ── Window dragging ────────────────────────────────────────────────
    local dragging, dragInput, dragStart, startPos
    Background.InputBegan:Connect(function(input)
        if not ScreenGui.Parent then return end
        if input.UserInputType ~= Enum.UserInputType.MouseButton1 then return end
        local mouse = LocalPlayer:GetMouse()
        local mouseX, mouseY = mouse.X, mouse.Y

        local function inside(gui)
            local ax, ay = gui.AbsolutePosition.X, gui.AbsolutePosition.Y
            local sx, sy = gui.AbsoluteSize.X, gui.AbsoluteSize.Y
            return mouseX >= ax and mouseX <= ax + sx and mouseY >= ay and mouseY <= ay + sy
        end

        if inside(ScrollBarBg) then return end
        if inside(TopSliderBg) then return end
        if inside(UserInfoBox) then return end

        dragging = true
        dragStart = input.Position
        startPos = Background.Position
        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then
                dragging = false
            end
        end)
    end)

    Background.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement then
            dragInput = input
        end
    end)

    track(UserInputService.InputChanged:Connect(function(input)
        if not ScreenGui.Parent then return end
        if input == dragInput and dragging then
            local delta = input.Position - dragStart
            Background.Position = UDim2.new(
                startPos.X.Scale, startPos.X.Offset + delta.X,
                startPos.Y.Scale, startPos.Y.Offset + delta.Y
            )
        end
    end))

    -- ── Right Alt toggle + fade ────────────────────────────────────────
    local guiVisible = false
    local isFading = false
    local fadeDirection = 1
    local currentTransparency = 1
    local fadeSpeed = 4

    local function setGUIVisible(visible)
        if guiVisible == visible then return end
        guiVisible = visible
        isFading = true
        fadeDirection = visible and 1 or -1
    end

    track(RunService.RenderStepped:Connect(function(deltaTime)
        if not ScreenGui.Parent then return end
        if not isFading then return end

        currentTransparency = currentTransparency - (fadeDirection * fadeSpeed * deltaTime)
        if fadeDirection == 1 and currentTransparency <= 0 then
            currentTransparency = 0
            isFading = false
        elseif fadeDirection == -1 and currentTransparency >= 1 then
            currentTransparency = 1
            isFading = false
        end

        Background.ImageTransparency = currentTransparency
        Overlay.BackgroundTransparency = 0.35 * (1 - currentTransparency)
        Title.TextTransparency = currentTransparency
        MainFrame.BackgroundTransparency = 0.25 * (1 - currentTransparency)
        TopSliderBg.BackgroundTransparency = 0.3 + (currentTransparency * 0.7)
        ScrollBarBg.BackgroundTransparency = 0.5 + (currentTransparency * 0.5)
        UserInfoText.TextTransparency = currentTransparency
        UserInfoBox.BackgroundTransparency = 0.3 + (currentTransparency * 0.7)
        GlowStroke.Transparency = 0.5 + (currentTransparency * 0.5)

        for _, tab in ipairs(tabs) do
            tab.BackgroundTransparency = 0.5 + (currentTransparency * 0.5)
            tab.TextTransparency = currentTransparency
        end

        Background.Visible = currentTransparency < 1
    end))

    track(UserInputService.InputBegan:Connect(function(input, gp)
        if gp then return end
        if not ScreenGui.Parent then return end
        if input.KeyCode == Enum.KeyCode.RightAlt then
            setGUIVisible(not guiVisible)
        end
    end))

    -- ── Notification ───────────────────────────────────────────────────
    function Window:ShowNotification(text)
        local NotificationBg = Instance.new("Frame")
        NotificationBg.Name = "SuccessNotification"
        NotificationBg.Parent = ScreenGui
        NotificationBg.Size = UDim2.new(0, 250, 0, 60)
        NotificationBg.Position = UDim2.new(1, -270, 1, -80)
        NotificationBg.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
        NotificationBg.BackgroundTransparency = 0.2
        NotificationBg.ZIndex = 50

        local NC = Instance.new("UICorner")
        NC.CornerRadius = UDim.new(0, 8)
        NC.Parent = NotificationBg

        local DecalImage = Instance.new("ImageLabel")
        DecalImage.Parent = NotificationBg
        DecalImage.Size = UDim2.new(0, 50, 0, 50)
        DecalImage.Position = UDim2.new(0, 5, 0.5, -25)
        DecalImage.BackgroundTransparency = 1
        DecalImage.Image = "rbxassetid://7652272031"
        DecalImage.ZIndex = 51

        local SuccessText = Instance.new("TextLabel")
        SuccessText.Parent = NotificationBg
        SuccessText.Size = UDim2.new(1, -65, 1, 0)
        SuccessText.Position = UDim2.new(0, 60, 0, 0)
        SuccessText.BackgroundTransparency = 1
        SuccessText.Text = text
        SuccessText.TextColor3 = GUI_COLORS.Text
        SuccessText.Font = Enum.Font.GothamBold
        SuccessText.TextSize = 18
        SuccessText.TextAlignment = Enum.TextAlignment.Left
        SuccessText.ZIndex = 51

        local t, duration, fadeIn, fadeOut = 0, 3, 0.5, 0.5
        local conn
        conn = RunService.RenderStepped:Connect(function(dt)
            t = t + dt
            local alpha = 1
            if t < fadeIn then alpha = t / fadeIn
            elseif t > duration - fadeOut then alpha = math.max(0, 1 - (t - (duration - fadeOut)) / fadeOut) end
            NotificationBg.BackgroundTransparency = 0.2 + 0.8 * (1 - alpha)
            DecalImage.ImageTransparency = 1 - alpha
            SuccessText.TextTransparency = 1 - alpha
            if t >= duration then
                conn:Disconnect()
                NotificationBg:Destroy()
            end
        end)
        return NotificationBg
    end

    function Window:Toggle()
        setGUIVisible(not guiVisible)
    end

    function Window:Destroy()
        ScreenGui:Destroy()
    end

    _G[SCRIPT_ID] = {
        Gui = ScreenGui,
        Connections = Connections,
        Window = Window,
    }

    setGUIVisible(true)

    return Window
end

